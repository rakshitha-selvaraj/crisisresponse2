{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user profile, can be admin, volunteer, fire_station, ambulance, or regular user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "volunteer", "admin", "fire_station", "ambulance"] },
        "serviceType": { "type": "string", "enum": ["paramedic", "rescue_team", "firefighter", "general"] },
        "currentLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Represents an emergency reported by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the reporting user" },
        "userName": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["reported", "allocating", "assigned", "on_the_way", "reached", "resolved"] },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "responderLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "responderType": { "type": "string", "enum": ["fire", "ambulance", "volunteer"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "assignedVolunteerId": { "type": "string" },
        "assignedResponderId": { "type": "string" },
        "aiReportSummary": { "type": "string" },
        "aiPrioritization": { "type": "string" },
        "escalatedAt": { "type": "string", "format": "date-time" },
        "autoAssignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "description", "status", "location", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "incidents/{incidentId}": {
      "schema": "Incident",
      "description": "Collection of all emergency incidents."
    },
    "system/connection_test": {
      "schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string" }
        }
      },
      "description": "Used for verifying database connectivity on app startup."
    }
  }
}
